{
  "name": "dsh-workbench-ecs",
  "version": "0.3.1",
  "description": "DeepSeek Harness (Cordis) plugin: control Alibaba Cloud ECS instances through the local Workbench CLI — list/exec/upload/download/diagnose/deploy/session model tools plus a visual settings panel",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishuoyang/dsh-workbench-ecs.git"
  },
  "bugs": {
    "url": "https://github.com/nishuoyang/dsh-workbench-ecs/issues"
  },
  "homepage": "https://github.com/nishuoyang/dsh-workbench-ecs#readme",
  "keywords": [
    "deepseek-harness",
    "cordis",
    "aliyun",
    "alibaba-cloud",
    "ecs",
    "workbench",
    "agent",
    "plugin",
    "tool",
    "ssh",
    "settings",
    "ui"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:ui": "node test/ui-rpc.mjs",
    "test:e2e": "node test/e2e-local.mjs",
    "build:body": "node scripts/to-body.mjs test/body.generated.js"
  }
}

{
  "name": "dsh-workbench-ecs",
  "version": "0.2.0",
  "description": "DeepSeek Harness (Cordis) plugin: control Alibaba Cloud ECS instances through the local Workbench CLI — list/exec/upload/download/diagnose/deploy/session model tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishuoyang/dsh-workbench-ecs.git"
  },
  "bugs": {
    "url": "https://github.com/nishuoyang/dsh-workbench-ecs/issues"
  },
  "homepage": "https://github.com/nishuoyang/dsh-workbench-ecs#readme",
  "keywords": [
    "deepseek-harness",
    "cordis",
    "aliyun",
    "alibaba-cloud",
    "ecs",
    "workbench",
    "agent",
    "plugin",
    "tool",
    "ssh"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:e2e": "node test/e2e-local.mjs",
    "build:body": "node scripts/to-body.mjs test/body.generated.js"
  }
}
